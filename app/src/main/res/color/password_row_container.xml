<!--
Fill of a password row's container, selected or not.

The state lives here rather than in a drawable selector so that both colours can
come from the theme: attributes do resolve in a colour state list, but not in a
<selector> inside a drawable, which is why the selected fill used to be a
hardcoded translucent blue.
 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item
    android:color="?attr/colorSecondaryContainer"
    android:state_selected="true" />
  <item android:color="?attr/colorSurfaceVariant" />
</selector>
