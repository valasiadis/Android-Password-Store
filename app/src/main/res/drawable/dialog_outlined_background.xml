<!-- A dialog's surface with the hairline outline the app's other containers carry. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
  android:inset="@dimen/spacing_large">
  <shape android:shape="rectangle">
    <corners android:radius="@dimen/corner_radius_large" />
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke
      android:width="1dp"
      android:color="?attr/colorOutlineVariant" />
  </shape>
</inset>
