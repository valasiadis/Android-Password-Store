<!--
  A dialog's surface with the hairline outline the app's other containers carry. Given to the
  dialog as its background, which Material insets for it — an inset here as well would draw the
  edge twice.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle">
  <corners android:radius="@dimen/corner_radius_large" />
  <solid android:color="?attr/colorSurfaceContainerHigh" />
  <stroke
    android:width="1dp"
    android:color="?attr/colorOutlineVariant" />
</shape>
