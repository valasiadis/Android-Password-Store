<!--
  The circle a row's icon stands in, as the system settings stand theirs. White here and tinted
  where it is used, so the colour is the theme's: a colour attribute is not resolved everywhere a
  drawable can be inflated, and a tint always is.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="oval">
  <solid android:color="@android:color/white" />
</shape>
