<!--
  The only row of a block, rounded fully all round as a block on its own is, and filled
  as every list row is, with the touch drawn inside the same shape.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
  android:color="?attr/colorControlHighlight">
  <item android:id="@android:id/mask">
    <shape android:shape="rectangle">
      <corners
        android:bottomLeftRadius="@dimen/list_outer_corner_radius"
        android:bottomRightRadius="@dimen/list_outer_corner_radius"
        android:topLeftRadius="@dimen/list_outer_corner_radius"
        android:topRightRadius="@dimen/list_outer_corner_radius" />
      <solid android:color="@android:color/white" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners
        android:bottomLeftRadius="@dimen/list_outer_corner_radius"
        android:bottomRightRadius="@dimen/list_outer_corner_radius"
        android:topLeftRadius="@dimen/list_outer_corner_radius"
        android:topRightRadius="@dimen/list_outer_corner_radius" />
      <solid android:color="@color/list_row_fill" />
    </shape>
  </item>
</ripple>
