<!--
Two stacked layers sharing one rounded silhouette:

  1. the filled container, which is what separates a row from the window
     background. Its fill is a colour state list, so selecting a row changes the
     colour of this one shape rather than laying a tint over it — which also
     keeps both colours coming from the theme, since a drawable selector cannot
     resolve theme attributes but a colour state list can,
  2. the touch ripple, masked to the same corner radius.

The row itself is separated from its neighbours by margins on the item view, so
no insets are needed here.
 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="@dimen/corner_radius_medium" />
      <solid android:color="@color/password_row_container" />
      <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    </shape>
  </item>
  <item>
    <ripple android:color="?attr/colorControlHighlight">
      <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
          <corners android:radius="@dimen/corner_radius_medium" />
          <solid android:color="@android:color/white" />
        </shape>
      </item>
    </ripple>
  </item>
</layer-list>
