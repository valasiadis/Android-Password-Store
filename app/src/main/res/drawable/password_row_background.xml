<!--
Three stacked layers sharing one rounded silhouette:

  1. the filled container, which is what separates a row from the window
     background. Theme attributes resolve here because this item is not inside
     a selector,
  2. the multi-select tint, which must use a literal colour since attributes
     cannot be resolved in selectors, see
     https://stackoverflow.com/a/36424426/297261,
  3. the touch ripple, masked to the same corner radius.

The row itself is separated from its neighbours by margins on the item view, so
no insets are needed here.
 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="@dimen/corner_radius_medium" />
      <solid android:color="?attr/colorSurfaceVariant" />
      <stroke
        android:width="1dp"
        android:color="@color/password_row_outline" />
    </shape>
  </item>
  <item>
    <selector>
      <item android:state_selected="true">
        <shape android:shape="rectangle">
          <corners android:radius="@dimen/corner_radius_medium" />
          <solid android:color="@color/list_multiselect_background" />
        </shape>
      </item>
      <item>
        <shape android:shape="rectangle">
          <corners android:radius="@dimen/corner_radius_medium" />
          <solid android:color="@android:color/transparent" />
        </shape>
      </item>
    </selector>
  </item>
  <item>
    <ripple android:color="?attr/colorControlHighlight">
      <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
          <corners android:radius="@dimen/corner_radius_medium" />
          <solid android:color="@android:color/white" />
        </shape>
      </item>
    </ripple>
  </item>
</layer-list>
