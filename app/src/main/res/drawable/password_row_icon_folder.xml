<!--
The row's type icon doubles as its selection indicator: while the row is
selected it shows a check instead. Driven by state rather than by the adapter
because a ViewGroup propagates its selected state to its children, so this stays
correct no matter when selection is applied relative to binding.
 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item
    android:drawable="@drawable/ic_done_24dp"
    android:state_selected="true" />
  <item android:drawable="@drawable/ic_action_new_folder" />
</selector>
