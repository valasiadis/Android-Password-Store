<!-- What a menu is drawn on: the scheme's own container colour, shaped like the app's others. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
  android:inset="0dp">
  <shape android:shape="rectangle">
    <corners android:radius="@dimen/corner_radius_medium" />
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke
      android:width="1dp"
      android:color="?attr/colorOutlineVariant" />
    <!-- Keeps the rows inside the rounding: a row's touch highlight is a rectangle, and one
         running into a corner would fill it in. -->
    <padding
      android:bottom="@dimen/spacing_small"
      android:top="@dimen/spacing_small" />
  </shape>
</inset>
