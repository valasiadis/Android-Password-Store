<!--
  Where the store lives and how this app is let in. Reached both as the last step of setting a
  store up and from the settings afterwards, so it wears the setup step's heading and its button
  in the corner while cloning, and neither once there is a store to edit the settings of.

  Laid out as the settings are: the address as a field, the way in as a choice, the key it uses
  and what can be done with it, then the connection itself — each a block of rows.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/windowBackground"
  tools:context="app.passwordstore.ui.git.config.GitServerConfigActivity">

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:fillViewport="true"
    app:layout_constraintBottom_toTopOf="@id/setup_footer"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="@dimen/password_list_margin"
      android:paddingTop="@dimen/password_list_margin_top"
      android:paddingBottom="@dimen/spacing_large">

      <include
        android:id="@+id/header"
        layout="@layout/setup_step_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xlarge"
        android:visibility="gone"
        tools:visibility="visible" />

      <app.passwordstore.ui.util.ListBlock
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputLayout
          android:id="@+id/label_server_url"
          style="@style/Widget.APS.ListField"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/server_url">

          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textWebEmailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

      </app.passwordstore.ui.util.ListBlock>

      <include
        android:id="@+id/auth_mode_header"
        layout="@layout/list_section_header" />

      <!-- Public key or password: one choice, as radio rows. Only a password works over HTTPS. -->
      <app.passwordstore.ui.util.ListBlock
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
          android:id="@+id/auth_mode_ssh_key"
          layout="@layout/list_choice_row" />

        <include
          android:id="@+id/auth_mode_password"
          layout="@layout/list_choice_row" />

      </app.passwordstore.ui.util.ListBlock>

      <!--
        Public-key authentication needs a key, and this is where the one in use is named: a row that
        says what is set and opens the ways of setting another, and below it what the server needs
        to be told about the key, which acts on it rather than picks it.
      -->
      <app.passwordstore.ui.util.ListBlock
        android:id="@+id/auth_key_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:visibility="gone"
        tools:visibility="visible">

        <include
          android:id="@+id/auth_key_row"
          layout="@layout/list_value_row" />

        <include
          android:id="@+id/auth_key_show"
          layout="@layout/list_action_row" />

      </app.passwordstore.ui.util.ListBlock>

      <!-- The connection itself: the server's key this app remembers, and its banner. -->
      <app.passwordstore.ui.util.ListBlock
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large">

        <include
          android:id="@+id/clear_host_key_button"
          layout="@layout/list_action_row" />

        <include
          android:id="@+id/show_server_response"
          layout="@layout/list_switch_row" />

      </app.passwordstore.ui.util.ListBlock>

    </LinearLayout>

  </ScrollView>

  <include
    android:id="@+id/setup_footer"
    layout="@layout/setup_step_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent"
    tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
