<!--
  Where a new PGP key comes from, as one block of rows marked with what each is.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="@dimen/password_list_margin"
  android:paddingTop="@dimen/spacing_xlarge"
  android:paddingBottom="@dimen/spacing_large">

  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
      android:id="@+id/import_key"
      style="@style/Widget.APS.ListIconRow">

      <androidx.appcompat.widget.AppCompatImageView
        style="@style/Widget.APS.ListIconRow.Icon"
        android:src="@drawable/ic_action_new_folder" />

      <androidx.appcompat.widget.AppCompatTextView
        style="@style/Widget.APS.ListIconRow.Title"
        android:text="@string/bottom_sheet_import_pgp_key" />

    </LinearLayout>

    <LinearLayout
      android:id="@+id/create_key"
      style="@style/Widget.APS.ListIconRow">

      <androidx.appcompat.widget.AppCompatImageView
        style="@style/Widget.APS.ListIconRow.Icon"
        android:src="@drawable/ic_action_new_pgp_key" />

      <androidx.appcompat.widget.AppCompatTextView
        style="@style/Widget.APS.ListIconRow.Title"
        android:text="@string/bottom_sheet_create_pgp_key" />

    </LinearLayout>

    <LinearLayout
      android:id="@+id/import_key_card"
      style="@style/Widget.APS.ListIconRow">

      <androidx.appcompat.widget.AppCompatImageView
        style="@style/Widget.APS.ListIconRow.Icon"
        android:src="@drawable/ic_miscellaneous_services_24px" />

      <androidx.appcompat.widget.AppCompatTextView
        style="@style/Widget.APS.ListIconRow.Title"
        android:text="@string/bottom_sheet_import_pgp_key_card" />

    </LinearLayout>

  </app.passwordstore.ui.util.ListBlock>

</LinearLayout>
