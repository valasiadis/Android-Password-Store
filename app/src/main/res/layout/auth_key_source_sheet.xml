<!--
  Where an authentication key can come from, in the same sheet the key manager uses to ask where a
  PGP key comes from: the choices as one block of rows, each said in full and marked with what it
  is.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="@dimen/password_list_margin"
  android:paddingTop="@dimen/spacing_xlarge"
  android:paddingBottom="@dimen/spacing_large">

  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
      android:id="@+id/auth_key_generate"
      style="@style/Widget.APS.ListIconRow">

      <androidx.appcompat.widget.AppCompatImageView
        style="@style/Widget.APS.ListIconRow.Icon"
        android:src="@drawable/ic_software_key_24dp" />

      <androidx.appcompat.widget.AppCompatTextView
        style="@style/Widget.APS.ListIconRow.Title"
        android:text="@string/setup_auth_key_source_generate" />

    </LinearLayout>

    <LinearLayout
      android:id="@+id/auth_key_import"
      style="@style/Widget.APS.ListIconRow">

      <androidx.appcompat.widget.AppCompatImageView
        style="@style/Widget.APS.ListIconRow.Icon"
        android:src="@drawable/ic_action_new_folder" />

      <androidx.appcompat.widget.AppCompatTextView
        style="@style/Widget.APS.ListIconRow.Title"
        android:text="@string/setup_auth_key_source_import" />

    </LinearLayout>

    <LinearLayout
      android:id="@+id/auth_key_pgp"
      style="@style/Widget.APS.ListIconRow">

      <androidx.appcompat.widget.AppCompatImageView
        style="@style/Widget.APS.ListIconRow.Icon"
        android:src="@drawable/ic_action_new_pgp_key" />

      <androidx.appcompat.widget.AppCompatTextView
        style="@style/Widget.APS.ListIconRow.Title"
        android:text="@string/setup_auth_key_source_pgp" />

    </LinearLayout>

  </app.passwordstore.ui.util.ListBlock>

</LinearLayout>
