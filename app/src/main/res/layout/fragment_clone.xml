<!--
  The app's name at the top, the way a title page carries it, and the one question this screen asks
  in the middle of what is left. Everything used to be pinned to the top with margins measured from
  there, which left the choice sitting high and the rest of the screen empty.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?android:attr/colorBackground"
  android:fillViewport="true">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/activity_horizontal_margin"
    android:paddingVertical="@dimen/spacing_xlarge">

    <!--
      Sized to carry the screen rather than to label it, and allowed to shrink back within the
      margins on a narrow screen instead of running off the sides of one.
    -->
    <LinearLayout
      android:id="@+id/app_header"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      app:layout_constrainedWidth="true"
      app:layout_constraintBottom_toTopOf="@id/repo_choice"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.5">

      <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/onboarding_app_icon_size"
        android:layout_height="@dimen/onboarding_app_icon_size"
        android:contentDescription="@string/app_icon_hint"
        android:src="@mipmap/ic_launcher" />

      <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_large"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textStyle="bold" />

    </LinearLayout>

    <!-- The question, centred in whatever the header leaves. -->
    <LinearLayout
      android:id="@+id/repo_choice"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.56">

      <!--
        The question, centred on the screen, with the mark that explains it set against its right
        edge. The text is what is centred, not the pair: a mark counted into the centring would
        push the question off it, and the question is what the screen is for. The text view is
        sized to its text rather than to the row so the mark has an edge to sit against, while
        staying bounded by the row so it can still shrink to fit a narrow screen.
      -->
      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
          android:id="@+id/repo_type"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:autoSizeMaxTextSize="24sp"
          android:autoSizeMinTextSize="16sp"
          android:autoSizeTextType="uniform"
          android:singleLine="true"
          android:text="@string/select_n_repository_type"
          android:textAlignment="center"
          android:textAppearance="?attr/textAppearanceHeadlineSmall"
          android:textStyle="bold"
          app:layout_constrainedWidth="true"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintWidth_default="wrap" />

        <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/repo_type_help"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:padding="@dimen/spacing_small"
          android:src="@drawable/ic_help_20dp"
          app:layout_constraintBottom_toBottomOf="@id/repo_type"
          app:layout_constraintStart_toEndOf="@id/repo_type"
          app:layout_constraintTop_toTopOf="@id/repo_type"
          app:tint="?attr/colorOnSurfaceVariant" />

      </androidx.constraintlayout.widget.ConstraintLayout>

      <com.google.android.material.button.MaterialButton
        android:id="@+id/clone_remote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_xxlarge"
        android:maxWidth="300dp"
        android:minWidth="200dp"
        android:text="@string/clone_remote_repo" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/create_local"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_small"
        android:maxWidth="300dp"
        android:minWidth="200dp"
        android:text="@string/create_local_repo" />

    </LinearLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
