<!--
  Making up a password, as blocks of rows: the one made, with a way to make another beside it; how
  long it is; and what goes into it, each a switch, as the settings set what is on and what is off.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="?attr/dialogPreferredPadding"
  android:paddingVertical="@dimen/activity_horizontal_margin">

  <include
    android:id="@+id/generated"
    layout="@layout/pwgen_generated_row" />

  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_large">

    <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/length"
      style="@style/Widget.APS.ListField"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="@string/pwgen_length">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/lengthNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="3" />

    </com.google.android.material.textfield.TextInputLayout>

  </app.passwordstore.ui.util.ListBlock>

  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_large">

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/numerals"
      style="@style/Widget.APS.ListSwitch"
      android:text="@string/pwgen_numerals" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/symbols"
      style="@style/Widget.APS.ListSwitch"
      android:text="@string/pwgen_symbols" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/uppercase"
      style="@style/Widget.APS.ListSwitch"
      android:text="@string/pwgen_uppercase" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/lowercase"
      style="@style/Widget.APS.ListSwitch"
      android:text="@string/pwgen_lowercase" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/pronounceable"
      style="@style/Widget.APS.ListSwitch"
      android:text="@string/pwgen_pronounceable" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/ambiguous"
      style="@style/Widget.APS.ListSwitch"
      android:text="@string/pwgen_ambiguous" />

  </app.passwordstore.ui.util.ListBlock>

</LinearLayout>
