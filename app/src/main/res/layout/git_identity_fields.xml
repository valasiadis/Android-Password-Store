<!--
  Who the commits belong to. Included by both the setup step that asks it and the settings screen
  that changes it later, so the same question is never asked twice in two different shapes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/username_input_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/git_user_name_hint">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/git_user_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textPersonName" />

  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/email_input_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_small"
    android:hint="@string/git_user_email">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/git_user_email"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textEmailAddress" />

  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.switchmaterial.SwitchMaterial
    android:id="@+id/sign_commits"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_large"
    android:text="@string/git_sign_commits" />

  <androidx.appcompat.widget.AppCompatTextView
    android:id="@+id/sign_commits_tip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/setup_sign_commits_tip"
    android:textAppearance="?attr/textAppearanceBodySmall"
    android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
