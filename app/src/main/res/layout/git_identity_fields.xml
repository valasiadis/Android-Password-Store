<!--
  Who the commits belong to. Included by both the setup step that asks it and the settings screen
  that changes it later, so the same question is never asked twice in two different shapes: the
  name and address as one block of fields, and signing as a switch row of its own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/username_input_layout"
      style="@style/Widget.APS.ListField"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="@string/git_user_name_hint">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/git_user_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPersonName" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/email_input_layout"
      style="@style/Widget.APS.ListField"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="@string/git_user_email">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/git_user_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textEmailAddress" />

    </com.google.android.material.textfield.TextInputLayout>

  </app.passwordstore.ui.util.ListBlock>

  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_large">

    <include
      android:id="@+id/sign_commits"
      layout="@layout/list_switch_row" />

  </app.passwordstore.ui.util.ListBlock>

</LinearLayout>
