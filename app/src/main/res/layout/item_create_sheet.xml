<!--
  What can be made in a folder, as one block of rows marked with what each makes — the way the
  password list marks a folder and an entry.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingHorizontal="@dimen/password_list_margin"
  android:paddingTop="@dimen/spacing_xlarge"
  android:paddingBottom="@dimen/spacing_large">

  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
      android:id="@+id/create_folder"
      style="@style/Widget.APS.ListIconRow">

      <androidx.appcompat.widget.AppCompatImageView
        style="@style/Widget.APS.ListIconRow.Icon"
        android:src="@drawable/ic_action_new_folder" />

      <androidx.appcompat.widget.AppCompatTextView
        style="@style/Widget.APS.ListIconRow.Title"
        android:text="@string/bottom_sheet_create_new_folder" />

    </LinearLayout>

    <LinearLayout
      android:id="@+id/create_password"
      style="@style/Widget.APS.ListIconRow">

      <androidx.appcompat.widget.AppCompatImageView
        style="@style/Widget.APS.ListIconRow.Icon"
        android:src="@drawable/ic_action_new_password" />

      <androidx.appcompat.widget.AppCompatTextView
        style="@style/Widget.APS.ListIconRow.Title"
        android:text="@string/bottom_sheet_create_new_password" />

    </LinearLayout>

  </app.passwordstore.ui.util.ListBlock>

</LinearLayout>
