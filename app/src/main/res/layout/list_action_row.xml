<!--
  Something to do rather than something to set, as the system settings offer one: a row with its
  name, and what it does beneath when that needs saying — no chevron, since it opens nothing to
  choose from. Its background comes from the ListBlock it stands in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:clickable="true"
  android:focusable="true"
  android:gravity="center_vertical"
  android:minHeight="@dimen/password_row_height"
  android:orientation="vertical"
  android:paddingHorizontal="@dimen/spacing_large"
  android:paddingVertical="@dimen/spacing_medium"
  tools:background="@drawable/list_row_single">

  <androidx.appcompat.widget.AppCompatTextView
    android:id="@+id/action_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textAppearance="?attr/textAppearanceTitleMedium"
    android:textColor="?attr/colorOnSurface"
    tools:text="Clear saved host key" />

  <androidx.appcompat.widget.AppCompatTextView
    android:id="@+id/action_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant"
    android:visibility="gone"
    tools:text="The server's key will be asked about again on the next connection"
    tools:visibility="visible" />

</LinearLayout>
