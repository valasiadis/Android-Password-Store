<!--
  A setting that is on or off, as the system settings draw one: its name, what it does beneath when
  that needs saying, and the switch at the end. The whole row toggles it, not only the switch. Its
  background comes from the ListBlock it stands in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:clickable="true"
  android:focusable="true"
  android:gravity="center_vertical"
  android:minHeight="@dimen/password_row_height"
  android:orientation="horizontal"
  android:paddingHorizontal="@dimen/spacing_large"
  tools:background="@drawable/list_row_single">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingVertical="@dimen/spacing_medium">

    <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/switch_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="?attr/textAppearanceTitleMedium"
      android:textColor="?attr/colorOnSurface"
      tools:text="Encrypt in ASCII armor mode" />

    <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/switch_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="?attr/textAppearanceBodyMedium"
      android:textColor="?attr/colorOnSurfaceVariant"
      android:visibility="gone"
      tools:text="Stores passwords as text rather than binary"
      tools:visibility="visible" />

  </LinearLayout>

  <!-- Not clickable on its own: the row is what is tapped, and it toggles this. -->
  <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/switch_toggle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_medium"
    android:clickable="false"
    android:focusable="false" />

</LinearLayout>
