<!--
  A row that names a setting and shows its value, and opens where the value is chosen: the system
  settings' row for anything picked on a screen of its own, with the chevron that says so. Its
  background comes from the ListBlock it stands in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:clickable="true"
  android:focusable="true"
  android:gravity="center_vertical"
  android:minHeight="@dimen/password_row_height"
  android:orientation="horizontal"
  android:paddingStart="@dimen/spacing_large"
  android:paddingEnd="@dimen/spacing_medium"
  tools:background="@drawable/list_row_single">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingVertical="@dimen/spacing_medium">

    <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/value_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="?attr/textAppearanceTitleMedium"
      android:textColor="?attr/colorOnSurface"
      tools:text="Encryption key" />

    <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/value_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="2"
      android:textAppearance="?attr/textAppearanceBodyMedium"
      android:textColor="?attr/colorOnSurfaceVariant"
      tools:text="No key chosen yet" />

  </LinearLayout>

  <androidx.appcompat.widget.AppCompatImageView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_small"
    android:contentDescription="@null"
    android:src="@drawable/ic_keyboard_arrow_right_24dp"
    app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
