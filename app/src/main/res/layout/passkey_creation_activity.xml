<!--
  A passkey as blocks of rows, as the entry editor lays out an entry: where it goes, what the site
  told the app about it, how it shows up when one is picked, and what can be added to it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context="app.passwordstore.ui.crypto.PasskeyCreationActivity">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/password_list_margin"
    android:paddingTop="@dimen/password_list_margin_top"
    android:paddingBottom="@dimen/spacing_large">

    <app.passwordstore.ui.util.ListBlock
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/directory_input_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/directory_hint">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/directory"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clickable="true"
          android:focusable="false"
          tools:text="CATEGORY HERE" />

      </com.google.android.material.textfield.TextInputLayout>

    </app.passwordstore.ui.util.ListBlock>

    <!-- What the site said about the passkey: read here, not typed. -->
    <app.passwordstore.ui.util.ListBlock
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_large">

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/cred_id_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/cred_id_hint">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/cred_id"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:focusable="false"
          android:inputType="none" />

      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/cred_algorithm_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/cred_algorithm_hint">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/cred_algorithm"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:focusable="false"
          android:inputType="none" />

      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/username_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/crypto_username_hint">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/username"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:focusable="false"
          android:inputType="none" />

      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/fullname_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/fullname_hint">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/fullname"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:focusable="false"
          android:inputType="none" />

      </com.google.android.material.textfield.TextInputLayout>

    </app.passwordstore.ui.util.ListBlock>

    <app.passwordstore.ui.util.ListBlock
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_large">

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/reveal_passkey_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/password_row_height"
        android:paddingHorizontal="@dimen/spacing_large"
        android:text="@string/reveal_passkey_username"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    </app.passwordstore.ui.util.ListBlock>

    <app.passwordstore.ui.util.ListBlock
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/spacing_large">

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/extra_input_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/crypto_extra_label">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/extra_content"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="textMultiLine|textVisiblePassword" />

      </com.google.android.material.textfield.TextInputLayout>

      <include
        android:id="@+id/otp_import_button"
        layout="@layout/list_action_row" />

    </app.passwordstore.ui.util.ListBlock>

  </LinearLayout>

</ScrollView>
