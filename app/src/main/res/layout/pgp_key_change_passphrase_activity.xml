<!--
  Whose key, which of its parts, and the passphrases: the key as a fact, its parts as a choice, and
  the passphrases as a block of fields, each under its heading.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context="app.passwordstore.ui.pgp.PGPKeyChangePassphraseActivity">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/password_list_margin"
    android:paddingTop="@dimen/password_list_margin_top"
    android:paddingBottom="@dimen/spacing_large">

    <app.passwordstore.ui.util.ListBlock
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <include
        android:id="@+id/userid"
        layout="@layout/list_fact_row" />

    </app.passwordstore.ui.util.ListBlock>

    <include
      android:id="@+id/key_choices_header"
      layout="@layout/list_section_header" />

    <!-- One radio row for every part of the key whose passphrase can be changed, and one for all. -->
    <app.passwordstore.ui.util.ListBlock
      android:id="@+id/key_choices"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />

    <include
      android:id="@+id/passphrase_header"
      layout="@layout/list_section_header" />

    <app.passwordstore.ui.util.ListBlock
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/old_passphrase_input_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pgp_old_passphrase"
        android:visibility="gone"
        app:endIconMode="password_toggle"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/old_passphrase"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:imeOptions="actionNext"
          android:inputType="textPassword"
          android:nextFocusForward="@id/passphrase" />

      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passphrase_input_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pgp_new_passphrase"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/passphrase"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:imeOptions="actionNext"
          android:inputType="textPassword"
          android:nextFocusForward="@id/repeat_passphrase" />

      </com.google.android.material.textfield.TextInputLayout>

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/repeat_passphrase_input_layout"
        style="@style/Widget.APS.ListField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pgp_new_passphrase_repeated"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/repeat_passphrase"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:imeOptions="actionDone"
          android:inputType="textPassword" />

      </com.google.android.material.textfield.TextInputLayout>

    </app.passwordstore.ui.util.ListBlock>

  </LinearLayout>

</ScrollView>
