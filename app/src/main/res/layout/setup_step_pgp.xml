<!--
  Everything a store needs settled before it exists, as groups of rows the way the settings set
  theirs: the key, how entries are written, and where the repository is kept.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <!--
    A row rather than a field: it holds a value, says what that value is, and opens where it is
    chosen — the same shape the settings give anything picked on a screen of its own.
  -->
  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include
      android:id="@+id/gpg_key"
      layout="@layout/list_value_row" />

  </app.passwordstore.ui.util.ListBlock>

  <include
    android:id="@+id/encryption_header"
    layout="@layout/list_section_header" />

  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include
      android:id="@+id/ascii_armor"
      layout="@layout/list_switch_row" />

  </app.passwordstore.ui.util.ListBlock>

  <include
    android:id="@+id/repo_visibility_header"
    layout="@layout/list_section_header" />

  <!-- Inside the app, or in a shared folder other apps can reach: one choice, as radio rows. -->
  <app.passwordstore.ui.util.ListBlock
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include
      android:id="@+id/internal_repo"
      layout="@layout/list_choice_row" />

    <include
      android:id="@+id/shared_repo"
      layout="@layout/list_choice_row" />

  </app.passwordstore.ui.util.ListBlock>

</LinearLayout>
