<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <!--
    A field rather than a button: it holds a value, it says what that value is, and tapping it
    goes to where it is chosen — the same shape the folder's key wears elsewhere in the app.
  -->
  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/gpg_key_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/folder_encryption_key"
    app:endIconContentDescription="@string/folder_encryption_key_choose"
    app:endIconDrawable="@drawable/ic_keyboard_arrow_right_24dp"
    app:endIconMode="custom">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/gpg_key_value"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:clickable="true"
      android:cursorVisible="false"
      android:ellipsize="end"
      android:focusable="false"
      android:inputType="textNoSuggestions"
      android:paddingStart="@dimen/spacing_large"
      android:paddingEnd="@dimen/text_field_end_icon_room"
      android:singleLine="true"
      android:text="@string/setup_key_none_chosen" />

  </com.google.android.material.textfield.TextInputLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_xlarge"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatTextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/setup_encryption_title"
      android:textAppearance="?attr/textAppearanceTitleMedium"
      android:textColor="?attr/colorOnSurface" />

    <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/encryption_help"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_small"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:padding="@dimen/spacing_small"
      android:src="@drawable/ic_help_20dp"
      app:tint="?attr/colorOnSurfaceVariant" />

  </LinearLayout>

  <!-- What ASCII armor is stays behind the question mark, out of the way of the switch. -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_medium"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/ascii_armor_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/pref_pgp_ascii_armor_title"
      android:textAppearance="?attr/textAppearanceBodyLarge"
      android:textColor="?attr/colorOnSurface" />

    <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/ascii_armor_help"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spacing_small"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:padding="@dimen/spacing_small"
      android:src="@drawable/ic_help_20dp"
      app:tint="?attr/colorOnSurfaceVariant" />

    <Space
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/ascii_armor"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" />

  </LinearLayout>

</LinearLayout>
