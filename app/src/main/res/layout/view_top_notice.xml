<!--
  A line at the top of the screen saying what just happened, in the same place the app says what is
  currently happening. It goes away by itself and takes nothing with it.
-->
<androidx.appcompat.widget.AppCompatTextView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/notice_message"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:layout_gravity="top|center_horizontal"
  android:layout_marginHorizontal="@dimen/spacing_large"
  android:layout_marginTop="@dimen/spacing_small"
  android:background="@drawable/progress_overlay_background"
  android:elevation="6dp"
  android:gravity="center"
  android:paddingHorizontal="@dimen/spacing_large"
  android:paddingVertical="@dimen/spacing_medium"
  android:textAppearance="?attr/textAppearanceBodyMedium"
  android:textColor="?attr/colorOnSurface"
  tools:text="Password created" />
