<resources xmlns:tools="http://schemas.android.com/tools">
  <!--
    Spacing scale. Material 3 lays out on a 4dp grid; these are the steps we
    actually use. Prefer these over raw dp values so spacing stays consistent
    across screens.
  -->
  <dimen name="spacing_xsmall">4dp</dimen>
  <!-- A 24dp settings icon and the gap after it, in place of the library's 56dp column. -->
  <dimen name="settings_icon_frame">40dp</dimen>
  <dimen name="spacing_small">8dp</dimen>
  <dimen name="spacing_medium">12dp</dimen>
  <dimen name="spacing_large">16dp</dimen>
  <dimen name="spacing_xlarge">24dp</dimen>
  <dimen name="spacing_xxlarge">48dp</dimen>
  <!-- What a text field leaves free at its end for the icon drawn over it. -->
  <dimen name="popup_menu_elevation">3dp</dimen>
  <dimen name="text_field_end_icon_room">48dp</dimen>
  <!-- The same, where a field carries two icons at its end. -->
  <dimen name="text_field_two_end_icons_room">96dp</dimen>

  <!--
    Corner radius for drawables we draw by hand, matching the "medium" step of
    the Material 3 shape scale. Components styled with Material 3 widget styles
    get their corners from the theme and need nothing here. Add further steps
    only when something uses them: lint fails the build on unused resources.
  -->
  <dimen name="corner_radius_medium">12dp</dimen>
  <dimen name="corner_radius_small">4dp</dimen>
  <dimen name="corner_radius_large">16dp</dimen>

  <!--
    List item metrics. Rows carry their own filled, rounded container and are
    separated by a thin gap, so the space between rows is real layout space
    rather than transparent padding inside the background. The height is fixed
    rather than a minimum: a row naming the folder it came from would otherwise
    stand taller than one that does not, and a list of entries that are all the
    same kind of thing should not ripple.
  -->
  <dimen name="list_item_height">48dp</dimen>
  <!--
    What separates one row from the next. Narrow enough that a list still reads
    as one block, as the grouped entries on the settings screen do, but wide
    enough to tell one row from the next at a glance.
  -->
  <dimen name="list_item_gap">6dp</dimen>
  <!-- The hairline drawn around a row's container. -->
  <dimen name="list_item_outline">1dp</dimen>
  <!--
    Clearance below scrolling lists so the last row can scroll clear of the FAB
    instead of sitting underneath it. Paired with clipToPadding="false".
  -->
  <dimen name="list_scroll_bottom_padding">88dp</dimen>

  <!-- Default screen margins, per the Android Design guidelines. -->
  <dimen name="activity_horizontal_margin">16dp</dimen>
  <dimen name="activity_vertical_margin">16dp</dimen>
  <dimen name="fab_compat_margin">16dp</dimen>
  <!--
    Material leaves 14dp above and below a dialog's buttons on top of the padding the panel itself
    carries, which on a two-line question reads as a gap rather than as spacing. Overriding the
    library's own dimensions keeps every dialog in step, wherever it is built.
  -->
  <dimen name="m3_alert_dialog_action_top_padding" tools:ignore="UnusedResources" tools:override="true">4dp</dimen>
  <dimen name="m3_alert_dialog_action_bottom_padding" tools:ignore="UnusedResources" tools:override="true">8dp</dimen>
  <!-- What a dialog leaves free at each side of the screen. -->
  <dimen name="dialog_inset">24dp</dimen>
  <!-- The mark in the smartcard prompt, and the ring drawn around it. -->
  <dimen name="card_prompt_mark_size">40dp</dimen>
  <dimen name="card_prompt_ring_size">64dp</dimen>
  <dimen name="card_prompt_ring_thickness">3dp</dimen>
  <!-- The mark beside the app's name on the screen that opens the app for the first time. -->
  <dimen name="onboarding_app_icon_size">80dp</dimen>
  <!-- The search field between the two buttons, as tall as they are. -->
  <dimen name="search_bar_height">56dp</dimen>
  <!-- What that field leaves free on each side for those buttons. -->
  <dimen name="search_bar_side_room">88dp</dimen>
  <dimen name="normal_margin">8dp</dimen>
  <dimen name="bottom_sheet_item_height">56dp</dimen>
</resources>
