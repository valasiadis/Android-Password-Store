<resources>

  <style name="APSThemeM3.Toolbar" parent="Widget.Material3.Toolbar">
    <item name="android:background">?android:colorBackground</item>
  </style>

  <!--
    A Material 3 top app bar sits flat on the background at rest and expresses
    elevation with a surface tint once content scrolls under it, so the default
    drop shadow is dropped here. The shadow is only really noticeable in the
    light theme, where it falls on a near-white background.
  -->
  <style name="APSThemeM3.ActionBar" parent="Widget.Material3.ActionBar.Solid">
    <item name="elevation">0dp</item>
    <item name="background">?android:colorBackground</item>
  </style>

  <!--
    The overflow button and any action icons are tinted by colorControlNormal as
    resolved against the action bar's own theme, not against the app theme, so
    naming a colour on the style above would not reach them. This overlay is what
    puts them on the scheme's on-surface colour instead of the stock grey.
  -->
  <style name="APSThemeM3.ActionBarTheme" parent="ThemeOverlay.Material3.ActionBar">
    <item name="colorControlNormal">?attr/colorOnSurface</item>
    <item name="actionOverflowMenuStyle">@style/APSThemeM3.PopupMenu</item>
    <item name="popupMenuStyle">@style/APSThemeM3.PopupMenu</item>
  </style>

  <!--
    The menu behind the three dots is drawn by the platform, which gives it the platform's own
    surface rather than the scheme's — a grey that belongs to no other part of the app. Its
    background and its rounding come from the theme instead, like every other container.
  -->
  <style name="APSThemeM3.PopupMenu" parent="Widget.Material3.PopupMenu.Overflow">
    <item name="android:popupBackground">@drawable/popup_menu_background</item>
    <item name="android:popupElevation">@dimen/popup_menu_elevation</item>
  </style>


  <!-- A block's heading: small and bold, as the system settings head a group of rows. -->
  <style name="TextAppearance.APS.SectionHeader" parent="TextAppearance.Material3.TitleSmall">
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
  </style>

  <!--
    A text field as a row of a block: filled with the colour every row is filled with, with no
    outline and no underline, its corners given by the ListBlock it stands in. The label sits where
    a row's name does and the text where its value does, so a form reads as one more group of
    settings rather than as a stack of boxes.
  -->
  <style name="Widget.APS.ListField" parent="Widget.Material3.TextInputLayout.FilledBox">
    <item name="boxBackgroundColor">@color/list_row_fill</item>
    <item name="boxStrokeWidth">0dp</item>
    <item name="boxStrokeWidthFocused">0dp</item>
    <item name="boxCornerRadiusTopStart">@dimen/list_outer_corner_radius</item>
    <item name="boxCornerRadiusTopEnd">@dimen/list_outer_corner_radius</item>
    <item name="boxCornerRadiusBottomStart">@dimen/list_outer_corner_radius</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/list_outer_corner_radius</item>
    <item name="materialThemeOverlay">@style/ThemeOverlay.APS.ListField</item>
  </style>

  <style name="ThemeOverlay.APS.ListField" parent="">
    <item name="editTextStyle">@style/Widget.APS.ListField.EditText</item>
  </style>

  <!-- As tall as a row: the room above the text is where the label floats to. -->
  <style name="Widget.APS.ListField.EditText" parent="Widget.Material3.TextInputEditText.FilledBox">
    <item name="android:minHeight">@dimen/password_row_height</item>
    <item name="android:paddingStart">@dimen/spacing_large</item>
    <item name="android:paddingEnd">@dimen/spacing_large</item>
    <item name="android:paddingTop">28dp</item>
    <item name="android:paddingBottom">@dimen/spacing_medium</item>
  </style>
</resources>
