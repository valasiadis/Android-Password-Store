<resources>

  <style name="APSThemeM3.Toolbar" parent="Widget.Material3.Toolbar">
    <item name="android:background">?android:colorBackground</item>
  </style>

  <!--
    A Material 3 top app bar sits flat on the background at rest and expresses
    elevation with a surface tint once content scrolls under it, so the default
    drop shadow is dropped here. The shadow is only really noticeable in the
    light theme, where it falls on a near-white background.
  -->
  <style name="APSThemeM3.ActionBar" parent="Widget.Material3.ActionBar.Solid">
    <item name="elevation">0dp</item>
    <item name="background">?android:colorBackground</item>
  </style>

  <!--
    The overflow button and any action icons are tinted by colorControlNormal as
    resolved against the action bar's own theme, not against the app theme, so
    naming a colour on the style above would not reach them. This overlay is what
    puts them on the scheme's on-surface colour instead of the stock grey.
  -->
  <style name="APSThemeM3.ActionBarTheme" parent="ThemeOverlay.Material3.ActionBar">
    <item name="colorControlNormal">?attr/colorOnSurface</item>
  </style>

</resources>
