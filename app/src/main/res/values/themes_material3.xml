<resources>

  <style name="AppThemeM3" parent="APSThemeM3">
    <item name="fontFamily">@font/manrope</item>
    <item name="android:colorBackground">?attr/colorSurfaceContainer</item>
    <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
    <item name="android:statusBarColor">?android:colorBackground</item>
    <item name="android:navigationBarColor">?android:colorBackground</item>
    <item name="toolbarStyle">@style/APSThemeM3.Toolbar</item>
    <item name="actionBarStyle">@style/APSThemeM3.ActionBar</item>
    <item name="actionBarTheme">@style/APSThemeM3.ActionBarTheme</item>
    <item name="bottomSheetDialogTheme">@style/APSThemeM3.BottomSheetDialog</item>
    <item name="materialAlertDialogTheme">@style/APSThemeM3.MaterialAlertDialog</item>
    <item name="actionOverflowMenuStyle">@style/APSThemeM3.PopupMenu</item>
    <item name="popupMenuStyle">@style/APSThemeM3.PopupMenu</item>
  </style>

  <!--
    The screen behind the app's lists, a step darker than the rows on it in the dark and a grey
    under near-white rows in the light, as the system settings have it. Set on AppThemeM3 for a
    device without dynamic colours, and laid over the theme again once dynamic colours have been,
    since they set the background back to the surface. Only the background colour: the window
    background follows it on its own, except where a theme has made the window transparent, which
    has to stay so.
  -->
  <style name="ThemeOverlay.APS.ScreenBackground" parent="">
    <item name="android:colorBackground">?attr/colorSurfaceContainer</item>
  </style>

  <style name="NoBackgroundThemeM3" parent="@style/AppThemeM3">
    <item name="android:background">@android:color/transparent</item>
    <!-- <item name="android:backgroundDimEnabled">true</item> -->
    <item name="android:backgroundDimEnabled">false</item>
    <!-- <item name="android:navigationBarColor">@android:color/transparent</item> -->
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
    <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    <item name="colorPrimaryDark">@android:color/transparent</item>
    <item name="windowNoTitle">true</item>
    <item name="android:windowBackground">@drawable/floating_window_background</item>
  </style>

  <style name="DialogLikeThemeM3" parent="AppThemeM3">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:backgroundDimEnabled">true</item>
    <!-- Needs to be set without android: prefix as per https://stackoverflow.com/a/33417456 -->
    <item name="windowNoTitle">true</item>
  </style>

  <!--
    What comes up over a screen stands a step above it. Material puts a bottom sheet on the low
    surface container and a dialog on the high one, measured against a screen of the plain surface;
    the screen here is the surface container (ThemeOverlay.APS.ScreenBackground), a step above that,
    so the sheets and dialogs stand a step higher too — a sheet below the screen it rises over reads
    as a hole in it, and a dialog one step above it barely as a dialog at all.
  -->
  <style name="APSThemeM3.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/APSThemeM3.BottomSheet</item>
    <item name="android:windowIsFloating">false</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <style name="APSThemeM3.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
    <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
  </style>

  <style name="APSThemeM3.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="alertDialogStyle">@style/APSThemeM3.MaterialAlertDialogStyle</item>
    <item name="buttonBarNegativeButtonStyle">@style/APSThemeM3.DialogButton.Quiet</item>
    <item name="buttonBarPositiveButtonStyle">@style/APSThemeM3.DialogButton.Action</item>
  </style>

  <!--
    A dialog's action, filled, as the setup flow fills its "Next" and every sheet its action: the
    one button that goes on stands apart from the ones that do not, in every question the app asks.
  -->
  <style name="APSThemeM3.DialogButton.Action" parent="Widget.Material3.Button">
    <item name="android:layout_marginStart">@dimen/spacing_small</item>
  </style>

  <!--
    A dialog's cancel, its "keep", its "later": the way back out, which is not the action being
    offered, so it does not stand in the same colour as that action. Set here once, rather than
    by each dialog that remembered to, so a question asked in one place looks like one asked in
    any other.
  -->
  <style name="APSThemeM3.DialogButton.Quiet" parent="Widget.Material3.Button.TextButton.Dialog">
    <item name="android:textColor">@color/dialog_quiet_button_text</item>
  </style>

  <!--
    For the rare dialog whose buttons are all answers and none of them a way out — which SSH key
    to use, say — so none of them is made quieter than the rest.
  -->
  <!--
    For a dialog whose action cannot be taken back — deleting a key, a repository, a lock; going
    ahead with a passphrase too weak to protect anything. Material 3 has no "warning" role; error
    is what it gives destructive actions, so the action is filled with that colour, here once
    rather than in each dialog that offers one.
  -->
  <style name="APSThemeM3.MaterialAlertDialog.Destructive">
    <item name="buttonBarPositiveButtonStyle">@style/APSThemeM3.DialogButton.Destructive</item>
  </style>

  <style name="APSThemeM3.DialogButton.Destructive" parent="APSThemeM3.DialogButton.Action">
    <item name="backgroundTint">?attr/colorError</item>
    <item name="android:textColor">?attr/colorOnError</item>
  </style>

  <style name="APSThemeM3.MaterialAlertDialog.Choices">
    <item name="buttonBarNegativeButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
  </style>

  <style name="APSThemeM3.MaterialAlertDialogStyle" parent="MaterialAlertDialog.Material3">
    <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
    <!-- Room to move up out of the keyboard's way on a short screen, rather than be cut off by it. -->
    <item name="backgroundInsetTop">0dp</item>
    <item name="backgroundInsetBottom">0dp</item>
  </style>

  <style name="APSThemeM3" parent="Theme.Material3.DayNight">
    <item name="colorPrimary">@color/md_theme_light_primary</item>
    <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
    <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
    <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
    <item name="colorSecondary">@color/md_theme_light_secondary</item>
    <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
    <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
    <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
    <item name="colorTertiary">@color/md_theme_light_tertiary</item>
    <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
    <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
    <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
    <item name="colorError">@color/md_theme_light_error</item>
    <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
    <item name="colorOnError">@color/md_theme_light_onError</item>
    <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
    <item name="android:colorBackground">@color/md_theme_light_background</item>
    <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
    <item name="colorSurface">@color/md_theme_light_surface</item>
    <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
    <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
    <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
    <item name="colorOutline">@color/md_theme_light_outline</item>
    <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
    <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
    <item name="colorPrimaryInverse">@color/md_theme_light_primaryInverse</item>
  </style>

</resources>
